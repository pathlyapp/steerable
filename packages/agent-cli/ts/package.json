{
  "name": "@steerable/agent-cli",
  "version": "0.6.66",
  "description": "Product-neutral command line for a Steerable host. Products supply the bin name and brand.",
  "license": "Apache-2.0",
  "homepage": "https://steerableframework.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathlyapp/steerable.git",
    "directory": "packages/agent-cli/ts"
  },
  "bugs": {
    "url": "https://github.com/pathlyapp/steerable/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "steerable-cli": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "gen": "echo agent-cli",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:tui": "vitest run tests/tui.test.ts tests/tui-framework.test.ts tests/tui-edge-cases.test.ts tests/tui-open-renderer.test.ts tests/tui-platform.test.ts tests/tui-case-coverage.test.ts",
    "test:tui:pty": "vitest run tests/tui-tmux.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "check:drift": "echo ok"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.87.1",
    "@opentui/core": "0.5.12",
    "@steerable/agent-client": "workspace:*",
    "@steerable/agent-protocol": "workspace:*",
    "@steerable/agent-shell": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
